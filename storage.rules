rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isContentOwner() {
      return request.auth != null
        && request.auth.uid == 'ptQwoqUEzygvsm4BpfdvGruJnvj1';
    }

    function isAllowedImage() {
      return request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ]
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isAllowedAudio() {
      return request.resource.contentType in [
          'audio/mpeg',
          'audio/mp4',
          'audio/x-m4a',
          'audio/m4a',
          'audio/aac',
          'audio/wav',
          'audio/x-wav',
          'audio/ogg',
          'audio/webm'
        ]
        && request.resource.size <= 100 * 1024 * 1024;
    }

    match /passage-resources/{passageId}/{resourceId}/{fileName} {
      allow read: if isContentOwner();
      allow create, update: if isContentOwner()
        && (isAllowedImage() || isAllowedAudio());
      allow delete: if isContentOwner();
    }
  }
}
